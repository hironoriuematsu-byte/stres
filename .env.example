# クライアント公開可(RLS前提)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# サーバー専用(/api/invite で使用)。絶対に NEXT_PUBLIC_ を付けないこと
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 電子契約の事業者署名(HMAC-SHA256)の秘密鍵。サーバー専用。長いランダムな文字列(例: openssl rand -hex 32)。
# 未設定でも契約の締結はできるが、合意締結証明に事業者署名が付かない
CONTRACT_SIGNING_SECRET=your-long-random-secret
